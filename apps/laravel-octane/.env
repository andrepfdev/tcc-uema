APP_NAME=tcc-benchmark
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

SCENARIO_NAME=scenario-d
COMPUTE_SIZE=1000

OCTANE_SERVER=frankenphp

LOG_CHANNEL=stderr
LOG_LEVEL=error

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=benchmark
DB_USERNAME=benchmark
DB_PASSWORD=benchmark

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
