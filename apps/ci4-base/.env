CI_ENVIRONMENT = production
SCENARIO_NAME  = scenario-unknown
COMPUTE_SIZE   = 1000

app.baseURL   = 'http://localhost:8080/'
app.indexPage = ''

# PostgreSQL — valores sobrescritos pelo docker-compose via environment:
database.default.hostname = postgres
database.default.database = benchmark
database.default.username = benchmark
database.default.password = benchmark
database.default.DBDriver  = Postgre
database.default.port      = 5432
database.default.charset   = utf8
# pConnect=false garante que Cenários A e B abram nova conexão por request.
# Sem isso, um leitor poderia questionar se o PHP-FPM estava reutilizando
# conexões via PDO persistent — o que distorceria a comparação com Worker Mode.
database.default.pConnect  = false
