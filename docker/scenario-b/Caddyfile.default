{
    # FrankenPHP modo Classic — configuração PADRÃO de threads (sensibilidade; ~2x núcleos do hospedeiro)
    # Cada request inicia um novo contexto PHP (equivalente ao PHP-FPM)
    frankenphp
    order php_server before file_server
    admin off
}

:8080 {
    root * /app/public

    php_server

    log {
        output discard
    }
}
