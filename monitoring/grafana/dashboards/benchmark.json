{
  "title": "TCC UEMA — PHP Architecture Benchmark",
  "uid": "tcc-uema-benchmark",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "scenario",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(k6_http_reqs_total, scenario)",
        "label": "Cenário",
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requisições por Segundo (RPS)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(k6_http_reqs_total{scenario=~\"$scenario\"}[30s])",
          "legendFormat": "RPS",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 2,
      "title": "Latência HTTP (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(k6_http_req_duration_bucket[30s]))",
          "legendFormat": "p50",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.95, rate(k6_http_req_duration_bucket[30s]))",
          "legendFormat": "p95",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.99, rate(k6_http_req_duration_bucket[30s]))",
          "legendFormat": "p99",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 3,
      "title": "Virtual Users Ativos",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "k6_vus",
          "legendFormat": "VUs",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "fixedColor": "blue", "mode": "fixed" } }
      }
    },
    {
      "id": 4,
      "title": "Taxa de Erros HTTP (%)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "rate(k6_http_req_failed_total[30s]) * 100",
          "legendFormat": "Erros %",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "color": { "fixedColor": "red", "mode": "fixed" } }
      }
    },
    {
      "id": 5,
      "title": "Requisições com Falha (total)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(k6_http_req_failed_total)",
          "legendFormat": "Total de Falhas",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 100 }
          ]
        }}
      }
    },
    {
      "id": 6,
      "title": "CPU do Container (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".*app.*\"}[30s]) * 100",
          "legendFormat": "{{name}} CPU%",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      }
    },
    {
      "id": 7,
      "title": "RAM do Container (MB)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\".*app.*\"} / 1024 / 1024",
          "legendFormat": "{{name}} RAM (MB)",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "megabytes" }
      }
    },
    {
      "id": 8,
      "title": "Latência por Endpoint — /health",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 22, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(endpoint_health_duration_bucket[30s]))",
          "legendFormat": "/health p95 (ms)",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 9,
      "title": "Latência por Endpoint — /compute",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 22, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(endpoint_compute_duration_bucket[30s]))",
          "legendFormat": "/compute p95 (ms)",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 10,
      "title": "Latência por Endpoint — /memory",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 22, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(endpoint_memory_duration_bucket[30s]))",
          "legendFormat": "/memory p95 (ms)",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 11,
      "title": "Latência por Endpoint — /db (PostgreSQL)",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 22, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(endpoint_db_duration_bucket[30s]))",
          "legendFormat": "/db p95 (ms)",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ]
}
